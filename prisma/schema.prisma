generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum StaffRole {
  OWNER
  WAREHOUSE
  ACCOUNTANT
  SUPPORT
}

model StaffUser {
  id           String    @id @default(cuid())
  email        String    @unique
  passwordHash String
  name         String
  role         StaffRole
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

enum OrderStatus {
  PENDING
  CONFIRMED
  REJECTED
}

enum SupportTicketStatus {
  OPEN
  CLOSED
}

enum PromoCodeKind {
  PERCENT
  AMOUNT
  FREE_DELIVERY
  FREE_PRODUCT
}

model Customer {
  id            String          @id @default(cuid())
  email         String          @unique
  /** null — аккаунт только через Google. */
  passwordHash  String?
  googleId      String?         @unique
  name          String
  homeAddress   String          @default("")
  avatarUrl     String          @default("")
  /** 1 балл = 1 сом при оплате. */
  loyaltyPoints Int             @default(0)
  /** Суммарное время в приложении, секунды. */
  appSecondsTotal Int           @default(0)
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  refreshTokens RefreshToken[]
  cart          Cart?
  orders        Order[]
  supportTickets SupportTicket[]
  pushTokens    CustomerPushToken[]
  promoRedemptions PromoRedemption[]
}

/** FCM / Expo push-токен устройства клиента. */
model CustomerPushToken {
  id         String   @id @default(cuid())
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  token      String   @unique
  platform   String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([customerId])
}

model RefreshToken {
  id         String   @id @default(cuid())
  tokenHash  String   @unique
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  expiresAt  DateTime
  createdAt  DateTime @default(now())

  @@index([customerId])
}

model Product {
  id             String       @id @default(cuid())
  name           String
  description    String       @default("")
  priceCents     Int
  /** Закупочная себестоимость единицы, в тыйынах. */
  costCents      Int          @default(0)
  /** Скидка в процентах (1–70). Не сочетается с discountAmountCents. */
  discountPercent     Int?
  /** Скидка фиксированной суммой, в тыйынах. Не сочетается с discountPercent. */
  discountAmountCents Int?
  stockQuantity  Int          @default(0)
  isActive       Boolean      @default(true)
  imageUrl       String       @default("")
  categoryId     String?
  category       Category?    @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  subcategoryId  String?
  subcategory    Subcategory? @relation(fields: [subcategoryId], references: [id], onDelete: SetNull)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  cartItems      CartItem[]
  orderItems     OrderItem[]
  giftPromoCodes PromoCode[]

  @@index([categoryId])
  @@index([subcategoryId])
}

model Category {
  id            String        @id @default(cuid())
  name          String        @unique
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  subcategories Subcategory[]
  products      Product[]
}

model Subcategory {
  id         String   @id @default(cuid())
  name       String
  categoryId String
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  products   Product[]

  @@unique([categoryId, name])
  @@index([categoryId])
}

model Order {
  id              String      @id @default(cuid())
  customerId      String
  customer        Customer    @relation(fields: [customerId], references: [id], onDelete: Restrict)
  status          OrderStatus @default(PENDING)
  totalCents      Int
  discountCents   Int         @default(0)
  /** Сколько баллов списали при оформлении. */
  pointsSpent     Int         @default(0)
  /** Сколько баллов начислили при подтверждении. */
  pointsEarned    Int         @default(0)
  promoCodeId     String?
  promoCode       PromoCode?  @relation(fields: [promoCodeId], references: [id], onDelete: SetNull)
  promoCodeText   String      @default("")
  phone           String      @default("")
  address         String      @default("")
  comment         String?
  rejectionReason String?
  items           OrderItem[]
  promoRedemption PromoRedemption?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  @@index([customerId])
  @@index([status])
  @@index([promoCodeId])
}

model OrderItem {
  id             String  @id @default(cuid())
  orderId        String
  order          Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId      String
  product        Product @relation(fields: [productId], references: [id], onDelete: Restrict)
  productName    String
  priceCents     Int
  /** Себестоимость единицы на момент заказа, в тыйынах. */
  unitCostCents  Int     @default(0)
  quantity       Int
  lineTotalCents Int
  createdAt      DateTime @default(now())

  @@index([orderId])
}

model Cart {
  id         String     @id @default(cuid())
  customerId String     @unique
  customer   Customer   @relation(fields: [customerId], references: [id], onDelete: Cascade)
  items      CartItem[]
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt
}

model CartItem {
  id        String   @id @default(cuid())
  cartId    String
  cart      Cart     @relation(fields: [cartId], references: [id], onDelete: Cascade)
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Restrict)
  quantity  Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([cartId, productId])
}

model PromoCode {
  id                  String        @id @default(cuid())
  code                String        @unique
  kind                PromoCodeKind
  percentOff          Int?
  amountOffCents      Int?
  freeProductId       String?
  freeProduct         Product?      @relation(fields: [freeProductId], references: [id], onDelete: SetNull)
  maxTotalRedemptions Int?
  maxPerCustomer      Int           @default(1)
  redemptionCount     Int           @default(0)
  isActive            Boolean       @default(true)
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt
  redemptions         PromoRedemption[]
  orders              Order[]

  @@index([isActive])
  @@index([freeProductId])
}

model PromoRedemption {
  id            String    @id @default(cuid())
  promoCodeId   String
  promoCode     PromoCode @relation(fields: [promoCodeId], references: [id], onDelete: Restrict)
  customerId    String
  customer      Customer  @relation(fields: [customerId], references: [id], onDelete: Restrict)
  orderId       String    @unique
  order         Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  discountCents Int
  createdAt     DateTime  @default(now())

  @@index([promoCodeId])
  @@index([customerId])
}

model SupportTicket {
  id         String               @id @default(cuid())
  customerId String
  customer   Customer             @relation(fields: [customerId], references: [id], onDelete: Restrict)
  subject    String
  body       String
  imageUrls  String[]             @default([])
  status     SupportTicketStatus  @default(OPEN)
  staffReply String?
  createdAt  DateTime             @default(now())
  updatedAt  DateTime             @updatedAt

  @@index([customerId])
  @@index([status])
}
