DATABASE_URL=postgresql://shop:shop@localhost:5432/shop
JWT_SECRET=local-dev-change-me
STAFF_SEED_EMAIL=owner@local.test
STAFF_SEED_PASSWORD=changeme
# Client ID Google (через запятую, если несколько). Обычно тот же Web Client ID.
GOOGLE_CLIENT_IDS=
# JSON сервисного аккаунта Firebase (FCM v1) — целиком в одну строку, либо base64.
# Нужен для отправки пушей на Android device token.
FIREBASE_SERVICE_ACCOUNT_JSON=
